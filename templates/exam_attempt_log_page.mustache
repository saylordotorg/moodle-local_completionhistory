{{!
    @template local_completionhistory/exam_attempt_log_page

    The Exam Attempt Log staff page: whole-dataset stats cards, a link back to the
    ledger, the filter card and the results table.

    Context variables required for this template:
    * stats - array of {value, label, colour} cards; colour is a Bootstrap contextual name
    * ledgerurl - URL of the Achievement Ledger page
    * formhtml - the rendered filter form (pre-rendered HTML)
    * tablehtml - the rendered attempts table (pre-rendered HTML)

    Example context (json):
    {
        "stats": [
            {"value": "1,204", "label": "Total Attempts", "colour": "secondary"},
            {"value": "980", "label": "Passed", "colour": "success"}
        ],
        "ledgerurl": "https://example.com/local/completionhistory/achievement_ledger.php",
        "formhtml": "<form class=\"mform\"></form>",
        "tablehtml": "<table class=\"generaltable\"></table>"
    }
}}
<div class="lch-attempt-log">
    <div class="row mb-4">
        {{#stats}}
            <div class="col-md-2 col-sm-4 mb-2">
                <div class="card border-{{colour}}">
                    <div class="card-body text-center p-2">
                        <div class="h3 mb-0 text-{{colour}} font-weight-bold">{{value}}</div>
                        <div class="small text-muted">{{label}}</div>
                    </div>
                </div>
            </div>
        {{/stats}}
    </div>
    <a href="{{ledgerurl}}" class="btn btn-outline-secondary btn-sm mb-3">
        &#8592; {{#str}}achievementledger, local_completionhistory{{/str}}
    </a>
    <div class="card mb-4">
        <div class="card-header font-weight-bold">{{#str}}filter_heading, local_completionhistory{{/str}}</div>
        <div class="card-body">
            {{{formhtml}}}
        </div>
    </div>
    <div class="lch-attempt-log-table" data-region="attempt-log-table">
        {{{tablehtml}}}
    </div>
</div>
