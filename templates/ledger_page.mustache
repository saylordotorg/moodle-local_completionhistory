{{!
    @template local_completionhistory/ledger_page

    The Achievement Ledger staff page: the filter card followed by the results table.

    Context variables required for this template:
    * formhtml - the rendered filter form (pre-rendered HTML)
    * tablehtml - the rendered achievements table (pre-rendered HTML)

    Example context (json):
    {
        "formhtml": "<form class=\"mform\"></form>",
        "tablehtml": "<table class=\"generaltable\"></table>"
    }
}}
<div class="lch-ledger-page">
    <div class="card mb-4">
        <div class="card-header font-weight-bold">{{#str}}filter_heading, local_completionhistory{{/str}}</div>
        <div class="card-body">
            {{{formhtml}}}
        </div>
    </div>
    <div class="lch-ledger-table" data-region="ledger-table">
        {{{tablehtml}}}
    </div>
</div>
